NODE_ENV=development
PROJECT_NAME="NestJS Knex Starter"
API_PORT=3000
API_APP_KEY=change-me
API_DOMAIN=http://127.0.0.1:3000
WEB_DOMAIN=
WEB_URL=
API_ROUTE_PREFIX=api
API_GUIDE_LINK=
API_HOST_STAGING=
API_HOST_PRODUCTION=

# Scheduled jobs and request logging (z_request_logs)
IS_CRON_ON=false
IS_REQUEST_LOG_ON=false

# Rate limit per IP: THROTTLE_LIMIT requests per THROTTLE_TTL_SEC (auth routes use THROTTLE_AUTH_LIMIT)
THROTTLE_TTL_SEC=60
THROTTLE_LIMIT=100
THROTTLE_AUTH_LIMIT=10

# Swagger (outside NODE_ENV=development it needs BASIC_AUTH_PASSWORD)
IS_SWAGGER_UI_ACTIVE=true
SWAGGER_DOC_URL=rest-docs
BASIC_AUTH_USER_NAME=admin
BASIC_AUTH_PASSWORD=
APPLOGO=

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=nestjs_knex_starter

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_MAX_AGE_SEC=86400
JWT_REFRESH_MAX_AGE_SEC=2592000
JWT_RESET_PASSWORD_MAX_AGE_SEC=900
# Comma separated OAuth client IDs (web, iOS, Android)
GOOGLE_CLIENT_IDS=
# Comma separated Apple bundle / service IDs
APPLE_SIGN_IN_BUNDLE_IDS=

# Email (emails are logged instead of sent when SMTP_HOST is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.com
SUPPORT_EMAIL=

# SMS (Twilio)
IS_SMS_ON=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# File storage (files are saved to public/uploads when AWS_S3_BUCKET is empty)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
CLOUD_FRONT_BUCKET_URL=

# App store redirect page (/api/common/app-store)
APP_OPEN_SLUG=nestjs_knex_starter
APP_ITUNES_URL=
GOOGLE_PLAY_URL=
