{
    "name": "nestjs-knex-starter",
    "version": "0.0.1",
    "description": "CRM API Server",
    "author": "SM Infosoft Pvt Ltd",
    "private": true,
    "license": "private",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "prebuild": "rimraf dist",
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "node dist/main",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "migrate:make": "cross-env NODE_ENV=make knex migrate:make -x ts",
        "migrate:latest": "knex migrate:latest",
        "migrate:rollback": "knex migrate:rollback",
        "seed:run": "knex seed:run",
        "db:create": "node scripts/db-create.js",
        "db:up": "docker compose up -d --wait",
        "db:down": "docker compose down",
        "setup": "npm run db:create && npm run build && npm run migrate:latest",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "typecheck": "tsc -p tsconfig.build.json --noEmit",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1141.0",
        "@aws-sdk/client-ses": "^3.1141.0",
        "@aws-sdk/lib-storage": "^3.1141.0",
        "@aws-sdk/s3-request-presigner": "^3.1141.0",
        "@nestjs/axios": "^4.0.1",
        "@nestjs/common": "^11.2.6",
        "@nestjs/config": "^4.0.4",
        "@nestjs/core": "^11.2.6",
        "@nestjs/event-emitter": "^3.1.0",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.2.6",
        "@nestjs/platform-socket.io": "^11.2.6",
        "@nestjs/schedule": "^6.1.3",
        "@nestjs/swagger": "^11.4.7",
        "@nestjs/terminus": "^11.1.1",
        "@nestjs/websockets": "^11.2.6",
        "axios": "^1.20.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "dotenv": "^18.0.4",
        "email-templates": "^13.0.1",
        "express": "^5.2.1",
        "express-basic-auth": "^1.2.1",
        "firebase-admin": "^14.5.0",
        "google-auth-library": "^11.1.0",
        "jsonwebtoken": "^9.0.3",
        "jwks-rsa": "^4.1.0",
        "knex": "^3.3.0",
        "moment": "^2.31.0",
        "moment-timezone": "^0.6.4",
        "mysql2": "^3.24.4",
        "nanoid": "^3.3.19",
        "nodemailer": "^9.1.1",
        "objection": "^3.1.5",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "passport-local": "^1.0.0",
        "pug": "^3.0.4",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "sharp": "^0.35.5",
        "twilio": "^6.1.1",
        "validator": "^13.15.35"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@nestjs/cli": "^11.0.24",
        "@nestjs/schematics": "^11.1.0",
        "@nestjs/testing": "^11.2.6",
        "@types/email-templates": "^10.0.4",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.2.0",
        "@types/node": "^24.0.0",
        "@types/nodemailer": "^8.0.2",
        "@types/passport-jwt": "^4.0.1",
        "@types/passport-local": "^1.0.38",
        "@types/pug": "^2.0.10",
        "@types/supertest": "^7.2.1",
        "@types/validator": "^13.15.10",
        "cross-env": "^10.1.0",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "globals": "^17.12.0",
        "jest": "^30.5.2",
        "prettier": "^3.9.9",
        "rimraf": "^6.1.3",
        "source-map-support": "^0.5.21",
        "supertest": "^7.3.0",
        "ts-jest": "^29.4.14",
        "ts-loader": "^9.6.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.70.1"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "moduleNameMapper": {
            "^src/(.*)$": "<rootDir>/$1"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    },
    "overrides": {
        "email-templates": {
            "nodemailer": "$nodemailer"
        },
        "uuid": "^11.1.1"
    }
}
