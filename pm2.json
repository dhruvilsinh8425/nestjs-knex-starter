{
    "apps": [
      {
        "name": "mobile-api-server",
        "script": "dist/main.js",
        "instances": 1,
        "autorestart": true,
        "watch": false,
        "env": {
          "NODE_ENV": "development"
        },
        "env_staging": {
          "NODE_ENV": "staging",
          "NO_COLOR": "enable"
        },
        "env_production": {
          "NODE_ENV": "production",
          "NO_COLOR": "enable"
        }
      }
    ]
  }
  